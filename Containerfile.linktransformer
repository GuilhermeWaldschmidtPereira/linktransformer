FROM python:3.10-slim

ENV DEBIAN_FRONTEND=noninteractive
ENV JULIA_VERSION=1.10.8
ENV PATH="/opt/julia/bin:${PATH}"
ENV PYTHONPATH="/workspace/src"
ENV JULIA_DEPOT_PATH="/opt/julia-depot"

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        build-essential \
        ca-certificates \
        cmake \
        curl \
        git \
        libopenblas-dev \
        patchelf \
        pax-utils \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /workspace

COPY requirements_podman_linktransformer.txt /tmp/requirements_podman_linktransformer.txt

RUN python -m pip install --upgrade pip setuptools wheel \
    && python -m pip install --no-cache-dir -r /tmp/requirements_podman_linktransformer.txt

RUN CXXFLAGS="-include cstdint" python -m pip install --no-cache-dir --no-build-isolation nmslib==2.1.1

RUN curl -fsSL "https://julialang-s3.julialang.org/bin/linux/x64/1.10/julia-${JULIA_VERSION}-linux-x86_64.tar.gz" \
    | tar -xz -C /opt \
    && ln -s "/opt/julia-${JULIA_VERSION}" /opt/julia \
    && patchelf --clear-execstack "/opt/julia-${JULIA_VERSION}/lib/julia/libopenlibm.so" \
    && scanelf -e "/opt/julia-${JULIA_VERSION}/lib/julia/libopenlibm.so"

RUN mkdir -p "${JULIA_DEPOT_PATH}"
RUN julia -e 'using Pkg; Pkg.add(["HNSW", "Distances", "NPZ"]); Pkg.precompile()'
RUN python -c "import julia; julia.install()" \
    && chmod -R a+rwX "${JULIA_DEPOT_PATH}"

CMD ["python-jl", "/workspace/run_linktransformer/main_linktransformer.py"]
