FROM docker.io/nvidia/cuda:12.9.2-runtime-ubuntu22.04

ENV DEBIAN_FRONTEND=noninteractive
ENV PYTHONPATH=/workspace/src
ENV PIP_NO_CACHE_DIR=1

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        build-essential \
        ca-certificates \
        cmake \
        curl \
        git \
        libopenblas-dev \
        software-properties-common \
    && add-apt-repository -y ppa:deadsnakes/ppa \
    && apt-get update \
    && apt-get install -y --no-install-recommends \
        python3.11 \
        python3.11-dev \
    && rm -rf /var/lib/apt/lists/*

RUN curl -fsSL https://bootstrap.pypa.io/get-pip.py | python3.11

WORKDIR /workspace

COPY requirements-cuvs.txt /tmp/requirements-cuvs.txt
RUN python3.11 -m pip install --upgrade pip setuptools wheel \
    && python3.11 -m pip install -r /tmp/requirements-cuvs.txt

COPY src ./src
COPY run_linktransformer ./run_linktransformer

CMD ["python3.11", "/workspace/run_linktransformer/main_cuvs_runner.py"]