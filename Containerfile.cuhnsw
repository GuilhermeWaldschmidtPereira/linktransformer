FROM docker.io/nvidia/cuda:12.6.3-devel-ubuntu22.04

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONPATH=/workspace/src \
    TORCH_CUDA_ARCH_LIST=8.6 \
    CUDA_ARCH=80 \
    CUDA_COMPUTE=80 \
    CUDA_SM_LIST=70,75,80,86,89,90 \
    PATH="/opt/venv/bin:${PATH}"

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        build-essential ca-certificates cmake git libopenblas-dev \
        python3.10 python3.10-dev python3.10-venv \
    && rm -rf /var/lib/apt/lists/*

RUN python3.10 -m venv /opt/venv \
    && python -m pip install --upgrade pip setuptools wheel

WORKDIR /workspace
COPY requirements_podman_linktransformer.txt /tmp/requirements_podman_linktransformer.txt
COPY build_support/requirements_cuhnsw_constraints.txt /tmp/requirements_cuhnsw_constraints.txt

RUN python -m pip install --no-cache-dir \
        --extra-index-url https://download.pytorch.org/whl/cpu \
        --constraint /tmp/requirements_cuhnsw_constraints.txt \
        -r /tmp/requirements_podman_linktransformer.txt \
    && python -m pip uninstall -y svs \
    && python -m pip install --no-cache-dir scalable-vs \
    && python -m pip install --no-cache-dir "setuptools==64.0.3"

RUN mkdir -p /tmp/cuhnsw-download /tmp/cuhnsw-src \
    && python -m pip download --no-deps --no-binary=:all: --no-build-isolation \
        --dest /tmp/cuhnsw-download "cuhnsw==0.0.8" \
    && tar -xzf /tmp/cuhnsw-download/cuhnsw-0.0.8.tar.gz \
        -C /tmp/cuhnsw-src --strip-components=1

COPY build_support/patch_cuhnsw_cpp17.py /tmp/patch_cuhnsw_cpp17.py
RUN python /tmp/patch_cuhnsw_cpp17.py /tmp/cuhnsw-src

RUN python -m pip install --no-cache-dir --no-build-isolation /tmp/cuhnsw-src

# The PyPI sdist omits config.proto and its generated config_pb2.py module.
COPY build_support/cuhnsw_config.proto /tmp/config.proto
RUN python -m grpc_tools.protoc \
        --proto_path=/tmp \
        --python_out="$(python -c 'import site; print(site.getsitepackages()[0] + "/cuhnsw")')" \
        config.proto

RUN python -m pip install --no-cache-dir --upgrade setuptools

CMD ["python", "/workspace/run_linktransformer/main_linktransformer.py"]
