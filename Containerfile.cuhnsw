FROM nvidia/cuda:11.1.1-devel-ubuntu20.04

ENV DEBIAN_FRONTEND=noninteractive
ENV PYTHONPATH=/workspace/src
ENV PIP_NO_CACHE_DIR=1

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        build-essential \
        ca-certificates \
        cmake \
        curl \
        git \
        libopenblas-dev \
        software-properties-common \
    && add-apt-repository -y ppa:deadsnakes/ppa \
    && apt-get update \
    && apt-get install -y --no-install-recommends \
        python3.9 \
        python3.9-dev \
    && rm -rf /var/lib/apt/lists/*

RUN curl -fsSL https://bootstrap.pypa.io/get-pip.py | python3.9

WORKDIR /workspace

COPY requirements-cuhnsw.txt /tmp/requirements-cuhnsw.txt
COPY requirements_podman_linktransformer.txt /tmp/requirements_podman_linktransformer.txt

RUN python3.9 -m pip install --upgrade pip setuptools wheel \
    && python3.9 -m pip install -r /tmp/requirements_podman_linktransformer.txt \
    && python3.9 -m pip install --no-build-isolation -r /tmp/requirements-cuhnsw.txt

COPY src ./src
COPY run_linktransformer ./run_linktransformer

CMD ["python3.9", "/workspace/run_linktransformer/main_cuhnsw_runner.py"]