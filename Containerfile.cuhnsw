FROM docker.io/nvidia/cuda:12.6.3-devel-ubuntu22.04

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONPATH=/workspace/src \
    TORCH_CUDA_ARCH_LIST=8.6 \
    CUDA_ARCH=80 \
    CUDA_COMPUTE=80 \
    CUDA_SM_LIST=70,75,80,86,89,90 \
    PATH="/opt/venv/bin:${PATH}"

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        build-essential ca-certificates cmake git libopenblas-dev \
        python3.10 python3.10-dev python3.10-venv \
    && rm -rf /var/lib/apt/lists/*

RUN python3.10 -m venv /opt/venv \
    && python -m pip install --upgrade pip setuptools wheel

WORKDIR /workspace
COPY requirements_podman_linktransformer.txt /tmp/requirements_podman_linktransformer.txt

RUN python -m pip install --no-cache-dir -r /tmp/requirements_podman_linktransformer.txt \
    && python -m pip uninstall -y svs \
    && python -m pip install --no-cache-dir scalable-vs \
    && python -m pip install --no-cache-dir "setuptools==64.0.3" \
    && python -m pip install --no-cache-dir --no-build-isolation "cuhnsw==0.0.8" \
    && python -m pip install --no-cache-dir --upgrade setuptools

CMD ["python", "/workspace/run_linktransformer/main_linktransformer.py"]
